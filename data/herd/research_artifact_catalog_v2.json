  "exclusion_rules": [
    {
      "id": "NO_LEGACY_FORMULA_REUSE",
      "applies_to": ["HERD_V4", "HERD_V6_1"],
      "rule": "새 HERD 후보는 과거 공식·가중치·임계값을 import하거나 재조정하지 않는다."
    },
    {
      "id": "NO_REJECTED_HYPOTHESIS_RETUNING",
      "applies_to": ["REJECTED"],
      "rule": "새로운 경제적 가설과 사전등록이 없으면 같은 표본에서 기간·임계값·가중치를 바꾸지 않는다."
    },
    {
      "id": "NO_PARSER_VERSION_LOOP",
      "applies_to": ["SEC_GUIDANCE_V2_TO_V10"],
      "rule": "기존 원문 오류 문법을 같은 방식으로 반복 수정하지 않고 검증된 atomic binding만 보조 veto 연구에 사용한다."
    },
    {
      "id": "NO_ACTION_FROM_STATE_ALONE",
      "applies_to": ["FLEE", "SCATTER", "DRIFT", "RUSH"],
      "rule": "HERD 상태만으로 매수·익절 행동을 승인하지 않는다."
    }
  ],
  "retention": {
    "delete_only_when": [
      "git import와 문서 참조가 모두 없음",
      "고정 manifest 또는 hash 입력이 아님",
      "실험 판정 재현에 필요하지 않음",
      "전체 회귀 테스트 통과"
    ],
    "unclassified_policy": "REVIEW_REQUIRED",
    "inventory_scope": {
      "roots": [
        {
          "path": "data/herd",
          "extensions": [".json"]
        },
        {
          "path": "data/reports",
