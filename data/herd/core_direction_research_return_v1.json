{
  "protocol_version": "HERD_CORE_DIRECTION_RESEARCH_RETURN_V1",
  "status": "LOCKED_BEFORE_ECONOMIC_TARGET_LEDGER",
  "objective": "For a preselected long-term winner, identify rare 5% partial profit takes or additional buys that improve after-cost wealth versus matched Buy & Hold without abandoning high exposure.",
  "source_events": "data/reports/rush_pre_damage_path_events_v2.csv",
