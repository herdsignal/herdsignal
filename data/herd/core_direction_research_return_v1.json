  "sec_authority": "data/reports/sec_auxiliary_veto_authority_v1.json",
  "survivorship_readiness": "data/reports/survivorship_readiness_v1.json",
  "action_contract": {
    "default_action": "HOLD",
    "partial_action_ratio": 0.05,
    "maximum_profit_takes_per_ticker_year": 2,
    "maximum_annual_profit_take_ratio": 0.10,
    "execution": "NEXT_TRADING_DAY_OPEN",
    "benchmark": "MATCHED_BUY_AND_HOLD",
    "base_and_stress_costs_required": true,
    "reentry_blocked_until_profit_take_passes": true
  },
  "required_target_columns": [
