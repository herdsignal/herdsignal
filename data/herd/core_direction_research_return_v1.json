  "standalone_before_combination": true,
  "failed_exact_hypotheses_not_reusable": [
    "PROFIT_TAKE_VOLATILITY_EXTENSION",
    "PROFIT_TAKE_TREND_DECELERATION",
    "PROFIT_TAKE_RELATIVE_STRENGTH_BREAK",
    "H1_SECTOR_RS_DAMAGE_4W",
