<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.herdsignal.weekly-report</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__ROOT_DIR__/scripts/weekly-operations-report.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__ROOT_DIR__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>20</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__ROOT_DIR__/runtime/logs/weekly-report.log</string>
  <key>StandardErrorPath</key>
  <string>__ROOT_DIR__/runtime/logs/weekly-report-error.log</string>
</dict>
</plist>
